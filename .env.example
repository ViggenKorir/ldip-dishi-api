# Names only. Never commit real values. The app refuses to start when a
# required variable is missing (src/common/config/env.validation.ts).

# --- Core ---
NODE_ENV=development
PORT=4000
DATABASE_URL=
DIRECT_URL=
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000
# Production: set to the exact web origin, e.g. https://dishi-app.vercel.app
FRONTEND_URL=

# --- Swagger ---
# Unset means: on outside production. Production with Swagger on needs both.
SWAGGER_ENABLED=
SWAGGER_BASIC_AUTH_USER=
SWAGGER_BASIC_AUTH_PASS=

# --- Identity (Supabase OAuth hand-off, DECISIONS #12/#17) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (N6 gate) ---
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_BASE_URL=
DARAJA_CALLBACK_SECRET=

# --- SMS (N4 gate) ---
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# --- Later phases ---
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
SENTRY_DSN=
REDIS_URL=
LOG_LEVEL=info
APP_BASE_URL=
