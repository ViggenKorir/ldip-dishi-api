// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

//Declaring models
model User {
  id String @id @default(uuid())

  email     String  @unique
  // Null for accounts created through a social provider (Supabase OAuth);
  // password accounts always store an argon2 hash.
  hash      String?
  firstName String?
  lastName  String?

  bookmarks Bookmark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // @@map("users")
}

model Bookmark {
  id String @id @default(uuid())

  title       String
  description String?
  link        String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // @@map("bookmarks")
}

enum ProjectStatus {
  active
  paused
  done
}

model Project {
  id          String        @id @default(uuid())
  name        String
  description String
  status      ProjectStatus
  updatedAt   DateTime      @updatedAt
  createdAt   DateTime      @default(now())
}
